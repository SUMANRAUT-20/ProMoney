# Copy this file to .env when you are ready to use the backend.
# Never commit your real .env file.
PORT=4000
CLIENT_ORIGIN=http://localhost:5173
# Database (MySQL 8+, database created by backend/sql/schema.sql)
DB_HOST=localhost
DB_PORT=3306
DB_USER=promoney_app
DB_PASSWORD=replace_me
DB_NAME=promoney
# Authentication (Phase 1) — required for /api/auth/*
# JWT_SECRET must be a long random string (at least 16 characters).
# Generate one, for example: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_secret
# Token lifetime in seconds (default: 604800 = 7 days)
JWT_EXPIRES_SECONDS=604800
# Google Sign-In — the OAuth 2.0 Web Client ID from Google Cloud Console.
# This is the SAME value as the frontend's VITE_GOOGLE_CLIENT_ID.
# The ID-token flow needs no client secret. Never put a client secret here
# or in chat. Requires migration 003_add_google_signin_to_users.sql.
GOOGLE_CLIENT_ID=replace_with_your_google_client_id
