# Copy this file to .env when you are ready to use the backend.
PORT=4000
CLIENT_ORIGIN=http://localhost:5173
# Database connection (MySQL) — needed for real login.
DB_HOST=localhost
DB_PORT=3306
DB_USER=promoney_app
DB_PASSWORD=replace_me
DB_NAME=promoney
# Cloud databases (TiDB Cloud, Aiven) require TLS — set to true for them; leave unset for local MySQL.
DB_SSL=true
# Secret used to sign login tokens. Use a long random string; never commit the real value.
JWT_SECRET=replace_with_a_long_random_string
