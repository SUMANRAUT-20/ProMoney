# Copy this file to .env for local development. Never commit your real .env.
# Backend API base URL (defaults to http://localhost:4000/api if unset)
VITE_API_URL=http://localhost:4000/api
# Google Sign-In — OAuth 2.0 Web Client ID from Google Cloud Console.
# This value is public (it identifies the app, it is not a secret) and must
# match the backend's GOOGLE_CLIENT_ID. Its Authorized JavaScript origins
# in Google Cloud Console must include this frontend's origin,
# e.g. http://localhost:5173
VITE_GOOGLE_CLIENT_ID=replace_with_your_google_client_id
