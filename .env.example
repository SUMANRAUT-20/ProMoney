# Copy this file to .env in the repository root for local development.
# Never commit your real .env file.

# --- Backend Server ---
PORT=4000
CLIENT_ORIGIN=http://localhost:5173

# --- Database (MySQL / TiDB Cloud) ---
DB_HOST=localhost
DB_PORT=3306
DB_USER=promoney_app
DB_PASSWORD=replace_me
DB_NAME=promoney
DB_SSL=true

# --- Authentication & Session (JWT + Google Sign-In) ---
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_SECONDS=604800
GOOGLE_CLIENT_ID=replace_with_your_google_client_id

# --- ProMoney LA-BO AI Providers ---
# AI_PROVIDER selects "meta" (primary, Meta Model API / Llama 4) or "groq" (fallback).
AI_PROVIDER=meta
META_API_KEY=
GROQ_API_KEY=

# --- Frontend (Vite) ---
VITE_API_URL=http://localhost:4000/api
VITE_GOOGLE_CLIENT_ID=replace_with_your_google_client_id
